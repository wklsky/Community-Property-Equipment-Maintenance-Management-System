{
  "name": "community-mobile-workspace",
  "version": "1.0.0",
  "private": true,
  "description": "社区物业设备维护管理系统 · 移动端 Monorepo 工作区",

  "scripts": {
    "dev:owner": "pnpm --filter @community/owner-app dev:h5",
    "dev:worker": "pnpm --filter @community/worker-app dev:h5",
    "dev:legacy": "pnpm --filter @community/legacy-app dev:h5",

    "build:owner": "pnpm --filter @community/owner-app build:h5",
    "build:worker": "pnpm --filter @community/worker-app build:h5",
    "build:legacy": "pnpm --filter @community/legacy-app build:h5",

    "build:mp:owner": "pnpm --filter @community/owner-app build:mp-weixin",
    "build:mp:worker": "pnpm --filter @community/worker-app build:mp-weixin",
    "build:mp:legacy": "pnpm --filter @community/legacy-app build:mp-weixin",

    "typecheck": "pnpm -r --filter @community/shared --filter @community/owner-app --filter @community/worker-app exec vue-tsc --noEmit"
  },

  "devDependencies": {
    "typescript": "~5.4.5",
    "vue-tsc": "^2.0.19"
  },



  "engines": {
    "node": ">=18",
    "pnpm": ">=8"
  }
}
